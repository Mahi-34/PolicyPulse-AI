[
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_001",
    "text": "| Document ID      | IT-POL-001                 |\n|------------------|----------------------------|\n| Department       | IT                         |\n| Document Type    | Policy                     |\n| Policy Title     | IT Asset Management Policy |\n| Version          | 2026                       |\n| Effective Date   | 01-Apr-2026                |\n| Owner Department | IT                         |",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
      "policy_title": "IT Asset Management Policy",
      "version": "2026",
      "effective_date": "01-Apr-2026",
      "owner_department": "IT",
      "document_id": "IT_IT_ASSET_POLICY",
      "section": "NovaCore Technologies Pvt. Ltd. IT ASSET POLICY",
      "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_001"
    }
  },
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_002",
    "text": "This policy establishes requirements for assignment, registration, use, transfer, return, recovery, and lifecycle management of NovaCore Technologies IT assets.",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
      "policy_title": "IT Asset Management Policy",
      "version": "2026",
      "effective_date": "01-Apr-2026",
      "owner_department": "IT",
      "document_id": "IT_IT_ASSET_POLICY",
      "section": "1. Purpose",
      "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_002"
    }
  },
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_003",
    "text": "This policy applies to employees, contractors where applicable, IT personnel, managers, and organizational IT assets.",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
      "policy_title": "IT Asset Management Policy",
      "version": "2026",
      "effective_date": "01-Apr-2026",
      "owner_department": "IT",
      "document_id": "IT_IT_ASSET_POLICY",
      "section": "2. Scope",
      "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_003"
    }
  },
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_004",
    "text": "Covered assets include laptops, desktops, mobile devices, tablets, network equipment, peripherals, and other IT equipment assigned or controlled by the organization.",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
      "policy_title": "IT Asset Management Policy",
      "version": "2026",
      "effective_date": "01-Apr-2026",
      "owner_department": "IT",
      "document_id": "IT_IT_ASSET_POLICY",
      "section": "3. Asset Categories",
      "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_004"
    }
  },
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_005",
    "text": "IT assigns assets based on approved role and business requirements. Asset assignment must be recorded in the applicable asset register and acknowledged by the recipient.",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
      "policy_title": "IT Asset Management Policy",
      "version": "2026",
      "effective_date": "01-Apr-2026",
      "owner_department": "IT",
      "document_id": "IT_IT_ASSET_POLICY",
      "section": "4. Asset Allocation",
      "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_005"
    }
  },
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_006",
    "text": "Employees must protect assigned assets, use them for authorized business purposes, follow security requirements, and report loss, theft, or damage promptly.",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
      "policy_title": "IT Asset Management Policy",
      "version": "2026",
      "effective_date": "01-Apr-2026",
      "owner_department": "IT",
      "document_id": "IT_IT_ASSET_POLICY",
      "section": "5. Employee Responsibility",
      "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_006"
    }
  },
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_007",
    "text": "IT maintains records including asset identifier, asset type, assigned employee, department, assignment date, status, and relevant lifecycle information.",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
      "policy_title": "IT Asset Management Policy",
      "version": "2026",
      "effective_date": "01-Apr-2026",
      "owner_department": "IT",
      "document_id": "IT_IT_ASSET_POLICY",
      "section": "6. Asset Registration",
      "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_007"
    }
  },
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_008",
    "text": "When an employee changes role or department, the manager should notify HR and IT. IT reviews assigned assets and determines whether equipment, configuration, or ownership records require modification.",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
      "policy_title": "IT Asset Management Policy",
      "version": "2026",
      "effective_date": "01-Apr-2026",
      "owner_department": "IT",
      "document_id": "IT_IT_ASSET_POLICY",
      "section": "7. Role Change and Transfer",
      "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_008"
    }
  },
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_009",
    "text": "Loss, theft, or material damage must be reported promptly to the manager and IT. IT records the incident and coordinates recovery, replacement, or further review as applicable.",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
      "policy_title": "IT Asset Management Policy",
      "version": "2026",
      "effective_date": "01-Apr-2026",
      "owner_department": "IT",
      "document_id": "IT_IT_ASSET_POLICY",
      "section": "8. Lost or Damaged Assets",
      "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_009"
    }
  },
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_010",
    "text": "Employees must return assigned IT assets by the final working day unless an approved exception applies. IT records returned assets and coordinates recovery of organizational equipment.",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
      "policy_title": "IT Asset Management Policy",
      "version": "2026",
      "effective_date": "01-Apr-2026",
      "owner_department": "IT",
      "document_id": "IT_IT_ASSET_POLICY",
      "section": "9. Offboarding and Asset Return",
      "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_010"
    }
  },
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_011",
    "text": "Returned assets are inspected, recorded, securely handled, and may be reassigned, repaired, retired, or disposed of according to applicable organizational requirements.",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
      "policy_title": "IT Asset Management Policy",
      "version": "2026",
      "effective_date": "01-Apr-2026",
      "owner_department": "IT",
      "document_id": "IT_IT_ASSET_POLICY",
      "section": "10. Recovery and Reassignment",
      "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_011"
    }
  },
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_012",
    "text": "IT manages asset records and lifecycle controls. Managers communicate employee and role changes. Employees safeguard assets and complete required returns. HR supports lifecycle information.",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
      "policy_title": "IT Asset Management Policy",
      "version": "2026",
      "effective_date": "01-Apr-2026",
      "owner_department": "IT",
      "document_id": "IT_IT_ASSET_POLICY",
      "section": "11. Responsibilities",
      "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_012"
    }
  },
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_013",
    "text": "Exceptions to asset return or assignment requirements require documented business justification and applicable approval.",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
      "policy_title": "IT Asset Management Policy",
      "version": "2026",
      "effective_date": "01-Apr-2026",
      "owner_department": "IT",
      "document_id": "IT_IT_ASSET_POLICY",
      "section": "12. Exceptions",
      "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_013"
    }
  },
  {
    "chunk_id": "IT_IT_ASSET_POLICY_CHUNK_014",
    "text": "2025 - Initial policy issued. 2026 - Asset lifecycle, role-change, and offboarding controls updated.",
    "metadata": {
      "department": "IT",
      "document_name": "IT_Asset_Policy",
      "document_type": "PDF",
      "source_file": "data/raw/IT/IT_Asset_Policy.pdf",
