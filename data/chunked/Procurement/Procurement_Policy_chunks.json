      "owner_department": "Procurement",
      "document_id": "PROCUREMENT_PROCUREMENT_POLICY",
      "section": "15. Revision History",
      "chunk_id": "PROCUREMENT_PROCUREMENT_POLICY_CHUNK_016"
    }
  }
]